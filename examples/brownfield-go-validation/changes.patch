 import (
 	"encoding/json"
+	"errors"
 	"net/http"
+	"strings"
 	"sync"
+	"unicode/utf8"
 )
+
+// MaxTitleLen is the longest title accepted, in characters.
+const MaxTitleLen = 200
+
+// maxBodyBytes caps request bodies so a huge payload cannot exhaust memory.
+const maxBodyBytes = 1 << 16
+
+// ValidateTitle trims surrounding whitespace and rejects empty or overlong titles.
+func ValidateTitle(title string) (string, error) {
+	title = strings.TrimSpace(title)
+	switch {
+	case title == "":
+		return "", errors.New("title must not be empty")
+	case utf8.RuneCountInString(title) > MaxTitleLen:
+		return "", errors.New("title must be at most 200 characters")
+	}
+	return title, nil
+}
+
+func writeError(w http.ResponseWriter, status int, msg string) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(map[string]string{"error": msg})
+}
 
