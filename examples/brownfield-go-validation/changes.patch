@@ -0,0 +1,62 @@
+package todo
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestValidateTitle(t *testing.T) {
+	cases := []struct {
+		in, want string
+		ok       bool
+	}{
+		{"buy milk", "buy milk", true},
+		{"  padded  ", "padded", true},
+		{"", "", false},
+		{"   ", "", false},
+		{strings.Repeat("a", MaxTitleLen), strings.Repeat("a", MaxTitleLen), true},
+		{strings.Repeat("a", MaxTitleLen+1), "", false},
+		{strings.Repeat("é", MaxTitleLen), strings.Repeat("é", MaxTitleLen), true}, // counts characters, not bytes
+	}
+	for _, c := range cases {
+		got, err := ValidateTitle(c.in)
+		if (err == nil) != c.ok || got != c.want {
+			t.Errorf("ValidateTitle(%q) = %q, %v; want %q, ok=%v", c.in, got, err, c.want, c.ok)
+		}
+	}
+}
+
+func TestCreateRejectsInvalidTitles(t *testing.T) {
+	store := &Store{}
+	srv := httptest.NewServer(Handler(store))
+	defer srv.Close()
+
+	for _, body := range []string{`{"title":""}`, `{"title":"   "}`, `{}`, `{"title":"` + strings.Repeat("x", MaxTitleLen+1) + `"}`, `not json`} {
+		res, err := http.Post(srv.URL+"/todos", "application/json", strings.NewReader(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		var e map[string]string
+		json.NewDecoder(res.Body).Decode(&e)
+		if res.StatusCode != http.StatusBadRequest || e["error"] == "" {
+			t.Errorf("body %.30q: got %d %v, want 400 with an error message", body, res.StatusCode, e)
+		}
+	}
+	if n := len(store.List()); n != 0 {
+		t.Fatalf("invalid requests stored %d todos", n)
+	}
+}
+
+func TestCreateStoresTrimmedTitle(t *testing.T) {
+	srv := httptest.NewServer(Handler(&Store{}))
+	defer srv.Close()
+	res, _ := http.Post(srv.URL+"/todos", "application/json", strings.NewReader(`{"title":"  ship it  "}`))
+	var got Todo
+	json.NewDecoder(res.Body).Decode(&got)
+	if res.StatusCode != http.StatusCreated || got.Title != "ship it" {
+		t.Fatalf("got %d %+v", res.StatusCode, got)
+	}
+}
