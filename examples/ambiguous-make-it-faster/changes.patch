+def _tags_for(db, note_ids: list[int]) -> dict[int, list[str]]:
+    """All tags for many notes in one query, instead of one query per note."""
+    out: dict[int, list[str]] = {}
+    if not note_ids:
+        return out
+    marks = ",".join("?" * len(note_ids))
+    for r in db.execute(f"SELECT note_id, tag FROM note_tags WHERE note_id IN ({marks}) ORDER BY rowid", note_ids):
+        out.setdefault(r["note_id"], []).append(r["tag"])
+    return out
 
 
